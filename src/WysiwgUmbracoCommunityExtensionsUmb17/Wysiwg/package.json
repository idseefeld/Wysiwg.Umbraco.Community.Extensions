{
  "name": "wysiwg-umbraco-community-extensions",
  "private": true,
  "license": "MIT",
  "version": "18.1.0-rc",
  "type": "module",
  "scripts": {
    "watch": "tsc && vite build --watch",
    "build-dev": "tsc && vite build --mode development",
    "generate-client": "node scripts/generate-openapi.js https://localhost:44313/umbraco/openapi/wysiwg-umbraco-community-extensions.json",
    "generate-management-client": "node scripts/generate-management-openapi.js https://localhost:44313/umbraco/openapi/management.json",
    "build-release": "tsc && vite build"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.97.3",
    "@umbraco-cms/backoffice": "^18.1.0",
    "chalk": "^5.6.2",
    "cross-env": "^10.1.0",
    "node-fetch": "^3.3.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "allowScripts": {
    "esbuild": true
  }
}
