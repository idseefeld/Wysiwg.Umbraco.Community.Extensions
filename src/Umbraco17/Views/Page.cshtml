@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Page>
@{
    Layout = null;
}
<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.Name</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <link href="~/styles/wysiwyg-blockgrid.min.css" rel="stylesheet" />
    <link href="~/css/custom/wysiwg-bgrid.css" rel="stylesheet" />
</head>

<body>
    <header>
    </header>
    <main>
        @await Html.GetBlockGridHtmlAsync(Model.Grid)
    </main>
    <footer>
        <p>&copy; @DateTime.Now.Year - <a href="/umbraco">My Umbraco Site</a></p>
    </footer>
</body>

</html>
