{
  "$schema": "./appsettings-schema.json",
  "Tests": {
    "Database": {
      "DatabaseType": "SQLite",
      "PrepareThreadCount": 2,
      "SchemaDatabaseCount": 2,
      "EmptyDatabasesCount": 1,
      "SQLServerMasterConnectionString": ""
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Umbraco.Cms.Tests": "Information"
    },
    "Console": {
      "DisableColors": true
    }
  },
  "Umbraco": {
    "CMS": {
      "Content": {
        "AllowedUploadedFileExtensions": [ "jpg", "png", "gif", "svg" ]
      },
      "Global": {
        "Smtp": {
          "From": "no-reply@test.com",
          "Host": "localhost",
          "Port": 25
        }
      },
      "WebRouting": {
        "_UmbracoApplicationUrl": "https://localhost",
        "ApplicationUrlDetection": "FirstRequest"
      }
    }
  }
}
