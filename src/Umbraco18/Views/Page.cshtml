@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.Page>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
    Layout = null;
    var hasGrid = Model.HasProperty("grid") && Model.GetProperty("grid") != null;

    var libElement = Model.LibPicker?.FirstOrDefault() as LibElement1;
    var libName = libElement?.Name;
    var libText = libElement?.Text;
}
<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.Name</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <link href="~/styles/wysiwyg-blockgrid.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
</head>

<body>
    <header>
    </header>
    <main>
        @if (hasGrid)
        {
            @await Html.GetBlockGridHtmlAsync(Model, "grid")
        }
        else
        {
            <div>
                @Model.Rte
            </div>

            @if (libElement != null)
            {
                <div>
                    <h3>@libName</h3>
                    <p>@libText</p>
                </div>
            }
        }
    </main>
    <footer>
        <p><a href="/">EN</a> | <a href="/de">DE</a> - &copy; @DateTime.Now.Year - <a href="/umbraco">My Umbraco Site</a></p>
    </footer>
</body>

</html>
